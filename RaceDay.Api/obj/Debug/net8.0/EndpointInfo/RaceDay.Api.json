  "paths": {
    "/api/authentication/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Register a new user(organiser or participant",
        "description": "Creates an app user and stores only a salted TKFY4 password hash.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
